# ─── Core ────────────────────────────────────────────────────────────────
# Postgres connection (Supabase, Neon, Railway, RDS or self-hosted all work).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lord_erroll_feedback?schema=public"
# Public URL of this deployment. QR codes and email links are built from it.
APP_URL="https://feedback.lord-erroll.com"
# Long random string. Generate with: openssl rand -base64 48
AUTH_SECRET=""
# Protects the digest cron endpoint. Generate with: openssl rand -hex 24
CRON_SECRET=""

# ─── Owner notifications ────────────────────────────────────────────────
# Comma-separated list. Every submission is emailed here in full.
OWNER_NOTIFY_EMAILS="s@lorderrll.com"
# International format, digits only (e.g. 254721920820). Used for WhatsApp/SMS alerts.
OWNER_ALERT_PHONE=""

# ─── Email (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY=""
# Must be on a domain verified in Resend.
EMAIL_FROM="The Lord Erroll <feedback@lord-erroll.com>"
EMAIL_REPLY_TO="reservations@lord-erroll.com"

# ─── SMS (Africa's Talking) — optional ──────────────────────────────────
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""

# ─── WhatsApp Business Cloud API — optional ─────────────────────────────
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Name of an approved utility template with one body parameter ({{1}} = summary).
WHATSAPP_TEMPLATE="new_feedback_alert"

# ─── Guest-facing links ─────────────────────────────────────────────────
# Paste the "Ask for reviews" link from Google Business Profile (https://g.page/r/.../review).
GOOGLE_REVIEW_URL=""
INSTAGRAM_URL="https://www.instagram.com/lord_erroll/"
FACEBOOK_URL=""
TRIPADVISOR_URL=""

# ─── Bot protection (Cloudflare Turnstile) — strongly recommended ───────
# Free at dash.cloudflare.com → Turnstile. Add your domain, widget mode "Managed".
# Leave both blank to switch the check off (local dev, smoke tests).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
